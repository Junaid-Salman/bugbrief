{
  "name": "conscribe",
  "version": "1.0.0",
  "description": "Package console errors, failed requests, the broken element and a screenshot into one agent-ready Markdown report.",
  "private": true,
  "license": "MIT",
  "author": "Junaid Salman",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "demo": "node demo/server.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:verify": "node scripts/demo-verify.mjs",
    "build:debug": "tsc --noEmit && vite build --mode debug",
    "package": "node scripts/package.mjs",
    "store:check": "node scripts/package.mjs check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Junaid-Salman/conscribe.git"
  },
  "bugs": {
    "url": "https://github.com/Junaid-Salman/conscribe/issues"
  },
  "homepage": "https://github.com/Junaid-Salman/conscribe#readme",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "debugging",
    "bug-report",
    "ai-agents"
  ],
  "dependencies": {
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "devtools-protocol": "^0.0.1720385",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
